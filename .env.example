# Copy this file to .env and fill in the values you need, then
# `docker compose up -d --build` will pick it up automatically.
# Every variable below is actually read by backend/app/core/config.py,
# backend/app/main.py, backend/app/workers/analysis_worker.py, or
# docker-compose.yml itself - nothing here is aspirational.

# --- LLM provider -----------------------------------------------------------
# Which provider app/core/llm_factory.py uses. One of: ollama, openai, groq, anthropic.
# Ollama is free and local - the default for this repo.
LLM_PROVIDER=ollama

# Model name for the chosen provider (e.g. llama3.1 for ollama, gpt-4o-mini for
# openai, llama-3.1-70b-versatile for groq, claude-sonnet-4-5 for anthropic).
LLM_MODEL=llama3.1

# Only used when LLM_PROVIDER=ollama. Docker containers reach the host's Ollama
# via host.docker.internal; running the backend outside Docker, use localhost.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# API keys - only required for the provider(s) you actually select above,
# or for the optional IP-reputation lookups.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
ABUSEIPDB_API_KEY=

# --- Datastores --------------------------------------------------------------
# These are pre-wired to the docker-compose service names/ports and normally
# don't need to change unless you're running components outside Docker.
DATABASE_URL=postgresql://soc_user:soc_password@localhost:5433/soc_db
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- App behavior -------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# Requests/minute per client IP enforced in app/main.py's rate limiter.
RATE_LIMIT_PER_MINUTE=120

# --- Optional: synthetic "distilled model" comparison label -----------------
# Cosmetic only (used as a display label in the synthetic-data demo endpoint).
# Leave blank unless you're using that feature.
STUDENT_MODEL_NAME=
STUDENT_LLM_PROVIDER=

# --- Frontend (Next.js) -------------------------------------------------------
# Base URL the browser uses to reach the backend API. Also copy this into
# frontend/.env.local if you run `npm run dev` outside Docker.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
